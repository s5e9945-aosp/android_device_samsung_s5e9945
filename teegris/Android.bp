    name: "tzts_daemon",
    init_rc: ["tzts_daemon.rc"],
    shared_libs: [
        "libcutils",
        "libteecl",
    ],
    header_libs: ["libteecl_headers"],
    srcs: ["tzts.c"],
    vendor: true,
}
